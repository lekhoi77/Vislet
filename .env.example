# Copy to .env.local and fill in values from Supabase Dashboard:
# Project Settings → API → Project URL & Publishable key (anon)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Quét hoá đơn/chuyển khoản bằng AI — tạo key miễn phí tại aistudio.google.com
# KHÔNG thêm tiền tố NEXT_PUBLIC_ — key này chỉ dùng phía server (route handler).
GEMINI_API_KEY=your-gemini-api-key
# Tuỳ chọn, mặc định gemini-3.6-flash nếu không set
# GEMINI_MODEL=gemini-3.6-flash

# Danh sách model dự phòng khi model chính hết quota free tier trong ngày
# (phân cách bởi dấu phẩy). Mỗi model có quota riêng nên cộng dồn được tổng
# dung lượng quét/ngày. Để trống (chuỗi rỗng) để tắt fallback.
# Mặc định nếu không set:
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
