# Copy to .env.local and fill in values from Supabase Dashboard:
# Project Settings → API → Project URL & Publishable key (anon)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Quét hoá đơn/chuyển khoản bằng AI — tạo key miễn phí tại aistudio.google.com
# KHÔNG thêm tiền tố NEXT_PUBLIC_ — key này chỉ dùng phía server (route handler).
GEMINI_API_KEY=your-gemini-api-key
# Tuỳ chọn, mặc định gemini-2.0-flash nếu không set
# GEMINI_MODEL=gemini-2.0-flash
